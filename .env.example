SEAR_CH_APP_NAME=sear_ch
SEAR_CH_APP_TAGLINE=A self-hosted web app for AI-augmented private search.
SEAR_CH_USER_AGENT=sear_ch/1.0

SEAR_CH_HOST=0.0.0.0
SEAR_CH_PORT=8891

SEARXNG_BASE_URL=http://127.0.0.1:8890
SEARXNG_TIMEOUT_SECONDS=10

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_DEFAULT_MODEL=gemma4:e2b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=240

SEAR_CH_DEFAULT_PROVIDER=searxng
SEAR_CH_DEFAULT_CATEGORIES=general
SEAR_CH_DEFAULT_LANGUAGE=auto
SEAR_CH_DEFAULT_SAFE_SEARCH=0
SEAR_CH_DEFAULT_TIME_RANGE=
SEAR_CH_DEFAULT_ENGINES=google,duckduckgo,bing,wikipedia

SEAR_CH_NEWS_DEFAULT_TIME_RANGE=month
SEAR_CH_NEWS_DEFAULT_ENGINES=google news,duckduckgo news,reuters
SEAR_CH_IMAGES_DEFAULT_ENGINES=duckduckgo images,qwant images,bing images
SEAR_CH_MAP_DEFAULT_ENGINES=apple maps,openstreetmap,photon
SEAR_CH_IT_DEFAULT_ENGINES=github,mdn,microsoft learn,hackernews
SEAR_CH_SCIENCE_DEFAULT_ENGINES=arxiv,openalex,semantic scholar,pubmed
SEAR_CH_ALLOWED_ENGINES=google,duckduckgo,wikipedia,bing,google news,duckduckgo news,reuters,bing news,qwant news,duckduckgo images,qwant images,bing images,apple maps,openstreetmap,photon,github,mdn,microsoft learn,hackernews,arxiv,openalex,semantic scholar,pubmed

SEAR_CH_AUTOCOMPLETE_PROVIDER=google
SEAR_CH_AUTOCOMPLETE_MIN_CHARS=2
SEAR_CH_AUTOCOMPLETE_LIMIT=8

SEAR_CH_READER_TIMEOUT_SECONDS=12
SEAR_CH_READER_MAX_BYTES=250000
SEAR_CH_READER_EXTRACT_CHARS=4500
SEAR_CH_READER_PREVIEW_TIMEOUT_SECONDS=1.5
SEAR_CH_READER_PREVIEW_MAX_BYTES=96000
SEAR_CH_ALLOW_PRIVATE_PAGE_FETCH=0

SEAR_CH_NEWS_PREVIEW_ENRICHMENT_LIMIT=4
SEAR_CH_MAX_ASSIST_SOURCES=5
